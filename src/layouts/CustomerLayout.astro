---
import BaseLayout from './BaseLayout.astro';
import CustomerNavigation from '../components/astro/CustomerNavigation.astro';
const { title = 'Pemesanan - Kedai Susu Segar Shi Boss', description = 'Pesan minuman dan makanan Shi Boss untuk dinikmati di meja.' } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="min-h-screen bg-cream-canvas text-heading-charcoal flex flex-col font-sans">
    <CustomerNavigation />
    <main class="w-full pt-[124px] lg:pt-20 flex-1 min-h-[calc(100vh-80px)]">
      <slot />
    </main>
  </div>
</BaseLayout>
